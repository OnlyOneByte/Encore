{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		// `arr[i]` and `map[key]` are typed as POSSIBLY UNDEFINED, which is what they are. This was declared only in
		// tsconfig.base.json, whose sole consumer is tests/tsconfig.json — so the test tree was type-checked more
		// strictly than the production code it tests. Declared here, where the app's program actually reads it.
		"noUncheckedIndexedAccess": true,
		"moduleResolution": "bundler",
		"types": ["bun-types"]
	},
	// The test tree has its OWN tsconfig (`tests/tsconfig.json`) declaring `@encore/test-support` and the
	// `$lib` aliases it needs, so it is excluded here rather than pulled into the APP's program as
	// SvelteKit's generated config would do.
	//
	// `exclude` REPLACES the base's list rather than extending it, so SvelteKit's own service-worker
	// exclusions are repeated here — dropping them would type-check the service worker against DOM lib
	// definitions it deliberately does not use.
	"exclude": [
		"node_modules/**",
		"tests/**",
		"src/service-worker.js",
		"src/service-worker/**/*.js",
		"src/service-worker.ts",
		"src/service-worker/**/*.ts",
		"src/service-worker.d.ts",
		"src/service-worker/**/*.d.ts"
	]
	// $lib/contract resolves via the Bun workspace symlink; no tsconfig paths needed
	// (a baseUrl/paths block here would conflict with SvelteKit's generated tsconfig).
}
