{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["bun-types"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"paths": {
			"$shared": ["./apps/core/src/shared/index.ts"],
			"$shared/*": ["./apps/core/src/shared/*.ts"]
		}
	},
	"include": ["packages", "apps/core/server.ts", "apps/core/src"]
}
