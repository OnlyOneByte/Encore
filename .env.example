# Encore core
PORT=3000
HOST=0.0.0.0

# SQLite (WAL) location. Created on first boot; no separate migrate step.
DATA_DIR=./data
# ENCORE_EPHEMERAL=1   # in-memory DB instead — a throwaway instance that persists nothing

# MediaStore backend: `local` (default, one box) or `object` (MinIO/S3 for remote workers)
MEDIA_STORE=local
MEDIA_DIR=./media

# Storage classes, split by REPLACEABILITY (docs/media-storage-spec.md §3). Each defaults under
# MEDIA_DIR; point one at its own volume to split the disks.
# ENCORE_AUDIO_DIR=./media/audio       # raw originals — NOT regenerable; this is what to back up
# ENCORE_DERIVED_DIR=./media/derived   # stems/pitch/lyrics/thumbs — safe to delete, recomputable
# ENCORE_META_DIR=./media/meta         # sidecar records — the authoritative library
# ENCORE_MEDIA_MAX_GB=20               # soft cap; evicts derived/ LRU-first. Unset = never delete

# TV "Next up" reveal duration in ms (0 = pure gapless hard-cut). Seeded into the room on FIRST BOOT
# only; the duration and on/off toggle live in Settings → Room afterwards.
# ENCORE_SONG_INTRO_MS=2500
# INTERSTITIAL_MS=2500   # DEPRECATED alias for ENCORE_SONG_INTRO_MS — still read, prefer the name above

# Address the TV's join QR advertises, e.g. http://10.69.1.169:3000. Unset = derive from the request.
# Set it when the box showing /tv cannot reach its own public address (a WSL2 host, or a proxy that
# forwards no X-Forwarded-* headers). This is the BOOT-TIME declaration; the "Global → Joining" setting
# overrides it PER RUNTIME with no restart, and an unset setting falls back to this var, then the request.
# ENCORE_PUBLIC_ORIGIN=http://10.69.1.169:3000

# Object-store (only when MEDIA_STORE=object) — see docs/MASTER-DESIGN.md §2.
# S3_BUCKET is required; without it Encore falls back to the local store rather than failing to boot.
# CREDENTIALS come from the standard AWS_* env vars, which Bun.S3Client reads directly —
# there is no S3_ACCESS_KEY/S3_SECRET_KEY setting.
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=encore-media
# S3_REGION=us-east-1
# S3_PREFIX=encore/
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Worker (container 2 — `docker compose --profile stems up`) ─────────────────
# Without a worker running, make-karaoke requests sit at `queued` forever.
ENCORE_CORE_WS=ws://core:3000/ws?role=worker
ENCORE_WORKER_CONCURRENCY=1
# stems = vocal removal; add `score` for the reference pitch track, `align` for word-timed lyrics
ENCORE_WORKER_CAPABILITIES=stems,score
# Shared secret required on role=worker WS upgrades. When core has ENCORE_WORKER_TOKEN set, a worker
# MUST present a matching token or the upgrade is rejected with 401. UNSET (on core) = worker
# registration is UNAUTHENTICATED: anything that can reach the port can register as a worker and start
# receiving jobs. Core logs one loud warning at boot when it is unset. Set the SAME value on both sides.
# ENCORE_WORKER_TOKEN=
# ENCORE_WORKER_ID=worker-1
# ENCORE_DEMUCS_MODEL=htdemucs
# ENCORE_WHISPERX_DEVICE=cpu          # `cuda` on a GPU box
# Lyrics engine FALLBACKS only — the core normally sends asrModel/syncMode on every `align` job (from
# its global settings), and that per-job value WINS with no worker restart. These are consulted solely
# for a job that carries neither, e.g. an older core.
# ENCORE_ASR_MODEL=base               # Whisper checkpoint used to transcribe the vocals stem
# ENCORE_SYNC_MODE=forced             # timing fidelity: `forced` (per-word) or line-level
# ENCORE_PROCESSOR=stub               # no-ML placeholder artifacts — tests plumbing, does NOT play
