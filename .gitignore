# deps
node_modules/
.bun/

# build output
.svelte-kit/
build/
dist/
vite.config.ts.timestamp-*

# stray tsc emit — compiled .js/.js.map next to a .ts source (e.g. `server.js`,
# `src/lib/contract/**/*.js`). Sources are .ts/.svelte only; any emitted .js/.map is build junk.
/server.js
/server.js.map
/src/**/*.js
/src/**/*.js.map

# orphaned pre-flatten layout — the repo moved apps/core/src -> src/ in the
# test-architecture restructure; a stale apps/ tree is leftover, never source.
/apps/

# data + media (runtime volumes — never commit)
# ANCHORED to repo root (leading /) so these only match the runtime volume dirs, NOT source
# directories like src/lib/server/media/ or src/routes/media/. An un-anchored
# `media/` previously matched those and silently excluded the entire M4 search subsystem from git.
/data/
/media/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# env
.env
.env.local

# python worker
__pycache__/
.mypy_cache/
.ruff_cache/
worker/.dev-ytdlp/
*.pyc
.venv/
.pytest_cache/

# os / editor
.DS_Store
*.log

# agent scratch — working specs and notes live here, never committed
.kiro
.eslintcache

# python wheels — never committed; a local wheelhouse for offline installs lives here
worker/wheelhouse/
*.whl
*.tar.gz

# Playwright run artifacts — frames, traces, and the HTML report. Regenerated by every run.
*/tests/playwright/.artifacts/*
*playwright-report/*

# Playwright's own bookkeeping dir (holds .last-run.json). It was committed once by accident.
*test-results/

core/data/
core/media/
core/tests/playwrite/.artifacts/

# Benchmark audio that a SCRIPT REBUILDS, so it is not committed:
#   youtube-mix.wav    re-downloaded by docs/benchmarks/stem-separation/scripts/fetch_baseline.sh
#   reference-*.wav    re-derived from the artist's stems by the same script, deterministically
# The STEMS themselves are the irreplaceable input and are committed — they are TheFatRat's royalty-free
# release, and re-deriving the reference from them is exact, so keeping ~190 MB of derived WAV in history
# would buy nothing.
docs/benchmarks/benchmark-songs/*/youtube-mix.wav
docs/benchmarks/benchmark-songs/*/reference-*.wav
