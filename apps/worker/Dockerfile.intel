# Worker image variant for an Intel Arc GPU host (e.g. Arc A380).
#
# Differs from the default worker image in exactly one way: it installs Intel Extension for PyTorch
# so torch exposes the `xpu` device. The separator code is unchanged — Arc is a torch DEVICE, not a
# separate backend — so nothing here forks the pipeline.
#
# Requirements on the HOST, not satisfiable from inside this file:
#   * an Intel Arc discrete GPU (or 11th-gen+ integrated Xe) and its kernel driver
#   * /dev/dri passed into the container (see the compose fragment below)
#
# Intel's own guidance is that integrated Xe can be SLOWER than CPU for this workload; the discrete
# Arc cards are the case worth using. Verify with a real cook before trusting it in a party.
#
# Build:
#   docker build -f apps/worker/Dockerfile.intel -t encore-worker:intel .
#
# Run (device passthrough is what makes xpu visible):
#   docker run --device /dev/dri:/dev/dri \
#     -e ENCORE_SEPARATOR_BACKEND=torch \
#     -e ENCORE_DEMUCS_DEVICE=xpu \
#     -e ENCORE_CORE_WS=ws://core:3000/ws?role=worker \
#     -v encore-media:/app/media encore-worker:intel
#
# Setting ENCORE_DEMUCS_DEVICE=xpu explicitly is deliberate: backends.py REFUSES an explicit device it
# cannot see, so a driver or passthrough mistake fails at worker startup instead of silently cooking
# on CPU and looking merely slow. Leave it unset to auto-detect instead.

FROM python:3.12-slim-bookworm AS runtime
WORKDIR /app/apps/worker

RUN apt-get update \
	&& apt-get install -y --no-install-recommends ffmpeg ca-certificates \
	&& rm -rf /var/lib/apt/lists/*

# deno + the yt-dlp solver config, identical to the default worker image: yt-dlp cannot resolve an
# audio-only YouTube format without a JavaScript runtime AND the challenge-solver remote component.
# Kept in both images deliberately — an Arc host still fetches its source audio the same way, and a
# GPU that cooks nothing because the download failed is not an improvement.
ARG DENO_VERSION=2.9.6
RUN python3 -c "import io,os,stat,urllib.request,zipfile; \
v=os.environ['DENO_VERSION']; arch=os.uname().machine; \
url=f'https://github.com/denoland/deno/releases/download/v{v}/deno-{arch}-unknown-linux-gnu.zip'; \
print('fetching', url, flush=True); \
zipfile.ZipFile(io.BytesIO(urllib.request.urlopen(url, timeout=300).read())).extract('deno', '/usr/local/bin'); \
p='/usr/local/bin/deno'; os.chmod(p, os.stat(p).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)" \
	&& deno --version \
	&& deno --version | grep -q "deno ${DENO_VERSION}"

COPY apps/worker/yt-dlp.conf /etc/yt-dlp.conf

# Base worker dependencies. TORCH_INDEX_URL stays overridable so this can track whichever torch build
# matches the installed IPEX.
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
COPY apps/worker/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --extra-index-url "${TORCH_INDEX_URL}" -r requirements.txt \
	&& yt-dlp --version

# Intel Extension for PyTorch. Pinned by ARG rather than baked so the version can be matched to the
# host driver without editing this file; IPEX and torch must agree on their minor version, and the
# XPU wheels live on Intel's index rather than PyPI.
ARG IPEX_VERSION=2.8.10+xpu
ARG IPEX_INDEX_URL=https://pytorch-extension.intel.com/release-whl/stable/xpu/us/
RUN pip install --no-cache-dir --extra-index-url "${IPEX_INDEX_URL}" \
	"intel-extension-for-pytorch==${IPEX_VERSION}" \
	|| (echo "IPEX install failed — check that IPEX_VERSION matches the pinned torch and that the index is reachable" && exit 1)

COPY apps/worker/src ./src

ENV PYTHONUNBUFFERED=1 \
	ENCORE_CORE_WS=ws://core:3000/ws?role=worker \
	ENCORE_WORKER_CONCURRENCY=1 \
	ENCORE_WORKER_CAPABILITIES=stems \
	MEDIA_DIR=/app/media
VOLUME ["/app/media"]

# Non-root, matching the default image. `video` and `render` group membership is what lets a non-root
# user reach /dev/dri; the numeric gids differ across distros, so an operator may need to align them
# with the host (`getent group render`) for passthrough to work.
RUN useradd --create-home --uid 10001 worker \
	&& mkdir -p /app/media \
	&& chown -R worker:worker /app
USER worker
ENV HOME=/home/worker XDG_CACHE_HOME=/home/worker/.cache

CMD ["python", "-m", "src.dial_home"]
