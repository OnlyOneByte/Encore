{
	"name": "@encore/core",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview",
		"start": "bun run ./server.ts",
		"prepare": "bun --bun svelte-kit sync || echo ''",
		"check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json",
		"typecheck": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json",
		"e2e": "bun run ./e2e/party.mjs",
		"e2e:seed": "bun run ./e2e/seed-media.mjs",
		"e2e:fuzz": "bun run ./e2e/fuzz.mjs",
		"e2e:lobby": "bun run ./e2e/lobby-overlap.mjs"
	},
	"dependencies": {
		"@encore/shared": "workspace:*",
		"@lucide/svelte": "^1.43.0",
		"bits-ui": "^2.16.3",
		"clsx": "2.1.1",
		"drizzle-orm": "^0.45.2",
		"layerchart": "^2.0.0",
		"qrcode": "^1.5.4",
		"svelte-sonner": "^1.1.0",
		"tailwind-merge": "3.6.0",
		"tailwind-variants": "^3.3.0"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "4.3.3",
		"@types/qrcode": "^1.5.6",
		"bun-types": "^1.3.14",
		"drizzle-kit": "^0.31.10",
		"shadcn-svelte": "1.6.1",
		"svelte": "^5.56.1",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "4.3.3",
		"typescript": "^5.6.0",
		"vite": "^8.0.16"
	}
}
