# Editor defaults for Encore. src/ is tab-indented; this pins that so an editor
# without the .prettierrc loaded still matches the formatter.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

[*.{json,yml,yaml,md}]
indent_style = space
indent_size = 2
