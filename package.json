{
	"name": "encore",
	"version": "0.0.0",
	"private": true,
	"description": "Self-hosted karaoke \u2014 mobile-first, wicked fast. Cleaner than any incumbent.",
	"workspaces": [
		"packages/*",
		"apps/core"
	],
	"scripts": {
		"dev": "bun --filter '@encore/core' dev",
		"build": "bun --filter '@encore/core' build",
		"start": "bun --filter '@encore/core' start",
		"check": "bun --filter '@encore/core' check",
		"test": "bun test",
		"typecheck": "bun --filter '*' typecheck && bun run typecheck:root",
		"lint": "eslint 'apps/**/*.{ts,mjs,svelte}' 'packages/**/*.{ts,mjs,svelte}'",
		"format": "prettier --write 'apps/**/*.{ts,svelte,mjs}' 'packages/**/*.{ts,svelte}' '*.{json,md}'",
		"format:check": "prettier --check 'apps/**/*.{ts,svelte,mjs}' 'packages/**/*.{ts,svelte}' '*.{json,md}'",
		"typecheck:root": "tsc -p apps/core/tsconfig.server.json"
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"bun-types": "1.3.14",
		"eslint": "^10.10.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "5.56.4",
		"svelte-eslint-parser": "^1.8.1",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.69.0"
	}
}
