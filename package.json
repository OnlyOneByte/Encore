{
	"name": "encore",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview",
		"start": "bun run ./server.ts",
		"prepare": "bun --bun svelte-kit sync || echo ''",
		"check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json",
		"typecheck": "bun run typecheck:app && bun run typecheck:root && bun run typecheck:e2e",
		"test": "bun test",
		"gates": "bun test || { echo 'gates: FAILED at leg 1/5 - bun test'; exit 1; }; (cd worker && python3 -m pytest -q) || { echo 'gates: FAILED at leg 2/5 - cd worker && python3 -m pytest -q'; exit 1; }; bun run typecheck || { echo 'gates: FAILED at leg 3/5 - bun run typecheck'; exit 1; }; bun run lint || { echo 'gates: FAILED at leg 4/5 - bun run lint'; exit 1; }; bun run build || { echo 'gates: FAILED at leg 5/5 - bun run build'; exit 1; }; echo 'gates: all 5 legs green'",
		"gate:measured": "bun run tests/e2e/gates/measured-design.mjs",
		"lint": "eslint --cache --cache-strategy content --cache-location .eslintcache 'src/**/*.{ts,mjs,svelte}' 'server.ts' 'tests/**/*.{ts,mjs,svelte}'",
		"format": "prettier --write 'src/**/*.{ts,svelte,mjs}' 'tests/**/*.{ts,svelte}' '*.{json,md}'",
		"deadcode": "npm_config_registry=https://registry.npmjs.org/ bunx knip@5",
		"format:check": "prettier --check 'src/**/*.{ts,svelte,mjs}' 'tests/**/*.{ts,svelte}' '*.{json,md}'",
		"typecheck:root": "tsc -p tsconfig.server.json",
		"typecheck:e2e": "tsc -p tests/tsconfig.e2e.json",
		"e2e": "bun run tests/e2e/party.mjs",
		"e2e:seed": "bun run tests/e2e/seed-media.mjs",
		"e2e:fuzz": "bun run tests/e2e/fuzz.mjs",
		"e2e:lobby": "bun run tests/e2e/lobby-overlap.mjs",
		"e2e:probes": "bun run tests/e2e/run-probes.mjs",
		"typecheck:app": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@lucide/svelte": "^1.43.0",
		"bits-ui": "^2.16.3",
		"clsx": "2.1.1",
		"drizzle-orm": "^0.45.2",
		"qrcode": "^1.5.4",
		"svelte-sonner": "^1.1.0",
		"tailwind-merge": "3.6.0",
		"tailwind-variants": "^3.3.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.56.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "4.3.3",
		"@types/qrcode": "^1.5.6",
		"bun-types": "^1.3.14",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.10.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"happy-dom": "^20.14.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"shadcn-svelte": "1.6.1",
		"svelte": "^5.56.1",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.6.0",
		"svelte-eslint-parser": "^1.8.1",
		"tailwindcss": "4.3.3",
		"typescript": "^5.6.0",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.0.16"
	}
}
