{
	"name": "encore",
	"description": "Self-hosted karaoke for a room full of phones",
	"license": "PolyForm-Noncommercial-1.0.0",
	"author": "OnlyOneByte (https://github.com/OnlyOneByte)",
	"homepage": "https://github.com/OnlyOneByte/Encore",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OnlyOneByte/Encore.git",
		"directory": "core"
	},
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"start": "bun run ./server.ts",
		"prepare": "bun --bun svelte-kit sync || echo ''",
		"check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json",
		"typecheck": "bun run check && bun run typecheck:root && bun run typecheck:tests",
		"test": "bun test",
		"gates": "bun run test || { echo 'gates: FAILED at leg 1/8 - bun run test'; exit 1; }; (cd ../worker && uv run pytest -q -m 'not ml') || { echo \"gates: FAILED at leg 2/8 - cd ../worker && uv run pytest -q -m 'not ml'\"; exit 1; }; (cd ../worker && uv run ruff check . && uv run ruff format --check . && uv run mypy) || { echo 'gates: FAILED at leg 3/8 - cd ../worker && uv run ruff check . && uv run ruff format --check . && uv run mypy'; exit 1; }; bun run typecheck || { echo 'gates: FAILED at leg 4/8 - bun run typecheck'; exit 1; }; bun run lint || { echo 'gates: FAILED at leg 5/8 - bun run lint'; exit 1; }; bun run format:check || { echo 'gates: FAILED at leg 6/8 - bun run format:check (fix with: bun run format)'; exit 1; }; bun run build || { echo 'gates: FAILED at leg 7/8 - bun run build'; exit 1; }; bun run gate:measured || { echo 'gates: FAILED at leg 8/8 - bun run gate:measured (CLAIM 1-15, measured on a real layout and the speed budget; needs the build above and a Chromium)'; exit 1; }; echo 'gates: all 8 legs green'",
		"gate:measured": "playwright test --project=gate --project=gate-speed",
		"lint": "eslint --cache --cache-strategy content --cache-location .eslintcache 'src/**/*.{ts,mjs,svelte}' 'server.ts' 'tests/**/*.{ts,mjs,svelte}'",
		"format": "prettier --write 'src/**/*.{ts,svelte,mjs}' 'tests/**/*.{ts,svelte}' '*.{json,md}'",
		"db:generate": "drizzle-kit generate --config config/drizzle.config.ts",
		"deadcode": "npm_config_registry=https://registry.npmjs.org/ bunx knip@5 --config config/knip.ts",
		"format:check": "prettier --check 'src/**/*.{ts,svelte,mjs}' 'tests/**/*.{ts,svelte}' '*.{json,md}'",
		"typecheck:root": "tsc -p tsconfig.server.json",
		"typecheck:tests": "bun --bun svelte-kit sync && tsc -p tests/tsconfig.json",
		"pw": "playwright test",
		"pw:flow": "playwright test --project=flow",
		"pw:probe": "playwright test --project=probe",
		"pw:shot": "playwright test --project=shot",
		"ui:review": "playwright test --project=shot motion.spec.ts",
		"ui:review:publish-media": "bun tests/playwright/ui-review-media.ts publish",
		"ui:review:prune-media": "bun tests/playwright/ui-review-media.ts prune"
	},
	"dependencies": {
		"@lucide/svelte": "^1.43.0",
		"bits-ui": "^2.16.3",
		"clsx": "2.1.1",
		"drizzle-orm": "^0.45.2",
		"qrcode": "^1.5.4",
		"svelte-sonner": "^1.1.0",
		"tailwind-merge": "3.6.0",
		"tailwind-variants": "^3.3.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.56.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "4.3.3",
		"@types/pngjs": "^6.0.5",
		"@types/qrcode": "^1.5.6",
		"@types/ws": "^8.18.1",
		"bun-types": "^1.3.14",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.10.0",
		"eslint-plugin-svelte": "^3.23.0",
		"gifenc": "^1.0.3",
		"globals": "^17.12.0",
		"happy-dom": "^20.14.0",
		"pngjs": "^7.0.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"shadcn-svelte": "1.6.1",
		"svelte": "^5.56.1",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.6.0",
		"svelte-eslint-parser": "^1.8.1",
		"tailwindcss": "4.3.3",
		"typescript": "^5.6.0",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.0.16",
		"ws": "^8.21.3"
	},
	"prettier": {
		"useTabs": true,
		"singleQuote": true,
		"printWidth": 120,
		"semi": true,
		"trailingComma": "none",
		"plugins": [
			"prettier-plugin-svelte"
		],
		"overrides": [
			{
				"files": "*.svelte",
				"options": {
					"parser": "svelte"
				}
			}
		],
		"svelteAllowShorthand": false
	},
	"patchedDependencies": {
		"svelte-adapter-bun@1.0.1": "patches/svelte-adapter-bun@1.0.1.patch"
	}
}
