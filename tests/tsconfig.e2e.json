{
	// Type gate for the out-of-program e2e `.mjs` drivers. Extends the server config for the same strictness.
	//
	// EVERY `.mjs` AND `.ts` UNDER `e2e/` IS LISTED, and that is the point rather than tidiness: a driver
	// outside this gate can reference a selector key that does not exist, and `JSON.stringify(undefined)`
	// then emits a bare token, so `querySelector` matches nothing and the wait times out against a reason
	// that has nothing to do with the app. Two drivers shipped that way (`SEL.bandExpand`, `SEL.hero`)
	// precisely because they were not in this list. A new driver goes here in the change that adds it.
	"extends": "../tsconfig.server.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"allowImportingTsExtensions": true
	},
	"include": [
		"e2e/capture.mjs",
		"e2e/contract.ts",
		"e2e/driver.mjs",
		"e2e/fake-align-worker.mjs",
		"e2e/fake-stems-worker.mjs",
		"e2e/fuzz.mjs",
		"e2e/gates/measured-design-register.mjs",
		"e2e/gates/measured-design.mjs",
		"e2e/lib/child.mjs",
		"e2e/lib/chromium.mjs",
		"e2e/lib/join.mjs",
		"e2e/lib/phone.mjs",
		"e2e/lib/repo-root.mjs",
		"e2e/lobby-overlap.mjs",
		"e2e/party.mjs",
		"e2e/playback.mjs",
		"e2e/probes/admin-delete.mjs",
		"e2e/probes/lower-third.mjs",
		"e2e/probes/p1-gapless.mjs",
		"e2e/probes/p10-scaling.mjs",
		"e2e/probes/p11-dashboards.mjs",
		"e2e/probes/p12-search.mjs",
		"e2e/probes/p13-tap-to-start.mjs",
		"e2e/probes/p14-playhead-vs-process.mjs",
		"e2e/probes/p15-phone-reflow.mjs",
		"e2e/probes/p15-reload-resume.mjs",
		"e2e/probes/p16-hero-live-controls.mjs",
		"e2e/probes/p2-guiding-track.mjs",
		"e2e/probes/p3-key-shift.mjs",
		"e2e/probes/p4-transport.mjs",
		"e2e/probes/p5-process-lifecycle.mjs",
		"e2e/probes/p6-lyrics.mjs",
		"e2e/probes/p8-presence-resilience.mjs",
		"e2e/probes/p9-settings.mjs",
		"e2e/probes/preflight-diff.mjs",
		"e2e/probes/preflight-reset-audit.mjs",
		"e2e/probes/tv-audiocontext-resume.mjs",
		"e2e/probes/tv-scrim-empty-lobby.mjs",
		"e2e/run-probes.mjs",
		"e2e/seed-media.mjs",
		"e2e/shoot.mjs",
		"e2e/shot-metrics.mjs",
		"e2e/shot-settings.mjs",
		"e2e/shot.mjs",
		"e2e/wav.mjs"
	],
	"exclude": ["build", "node_modules"]
}
